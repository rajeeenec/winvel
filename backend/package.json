{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:all",
    "start": "npm run start:all",
    "start:gateway": "node src/server.js",
    "start:auth": "node src/microservices/auth.service.js",
    "start:orders": "node src/microservices/orders.service.js",
    "start:files": "node src/microservices/file.service.js",
    "start:stock": "node src/microservices/stock.service.js",
    "start:catalog": "node src/microservices/catalog.service.js",
    "start:users": "node src/microservices/user.service.js",
    "start:settings": "node src/microservices/settings.service.js",
    "start:services": "concurrently \"npm run start:auth\" \"npm run start:orders\" \"npm run start:files\" \"npm run start:stock\" \"npm run start:catalog\" \"npm run start:users\" \"npm run start:settings\"",
    "start:all": "concurrently \"npm run start:services\" \"npm run start:gateway\"",
    "dev:services": "concurrently \"node --watch src/microservices/auth.service.js\" \"node --watch src/microservices/orders.service.js\" \"node --watch src/microservices/file.service.js\" \"node --watch src/microservices/stock.service.js\" \"node --watch src/microservices/catalog.service.js\" \"node --watch src/microservices/user.service.js\" \"node --watch src/microservices/settings.service.js\"",
    "dev:all": "concurrently \"npm run dev:services\" \"node --watch src/server.js\"",
    "db:init": "node src/scripts/init-db.js",
    "db:migrate": "knex migrate:latest",
    "db:migrate:rollback": "knex migrate:rollback",
    "db:seed": "node src/scripts/run-seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.3.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "razorpay": "^2.9.8"
  }
}
